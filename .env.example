# Web frontend
VITE_API_BASE_URL=http://localhost:8088
# Android/Capacitor builds need an absolute API origin.
# Current test build target is configured in .env.android.

# Node API
NODE_ENV=production
PORT=8088
APP_URL=
CORS_ORIGIN=
ADMIN_TOKEN=
SESSION_SECRET=
DATA_DIR=

# LLM proxy. Keep the real API key only on the server.
LLM_ENABLED=false
LLM_FAIL_CLOSED=false
# custom_api: OpenAI-compatible URL + model + key.
# port_external: external port URL, key optional unless the endpoint requires it.
LLM_CONNECTION_MODE=external
LLM_BASE_URL=
LLM_PORT_EXTERNAL_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=30000
LLM_RATE_LIMIT_WINDOW_MS=60000
LLM_RATE_LIMIT_MAX=60
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# Kongfu UI / ComfyUI. Fill this after the external port is opened.
COMFYUI_BASE_URL=
COMFYUI_TIMEOUT_MS=30000

# CSP extra connect-src origins (comma-separated). Replaces hardcoded IPs.
# Example: http://your-server-ip:8088,https://your-domain.com
CSP_EXTRA_CONNECT_SRC=
