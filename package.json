{
  "name": "persona-chat-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "node server/index.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "build": "vite build",
    "build:android": "vite build --mode android",
    "preview": "vite preview",
    "cap:sync": "cap sync android",
    "android:apk": "npm run build:android && cap sync android && cd android && gradlew.bat assembleRelease",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit",
    "release:check": "node scripts/check-release.mjs",
    "smoke": "node scripts/check-release.mjs",
    "ai:chain": "node scripts/check-ai-chain.mjs",
    "deploy:target:check": "node scripts/check-deploy-target.mjs",
    "deploy:vps:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-from-windows.ps1",
    "quality:gate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/quality-gate.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "nanoid": "^5.1.11",
    "pino-http": "^11.0.0",
    "pngjs": "^7.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
